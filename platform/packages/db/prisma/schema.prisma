  status      String    @default("scheduled") // scheduled | confirmed | completed | no_show | cancelled | rescheduled
  externalId  String?   @map("external_id")
  location    String?
  notes       String?
  /// Visit reminders (24h and 2h before) and the outcome prompt sent to the consultant after the end
  reminder24hSentAt DateTime? @map("reminder_24h_sent_at") @db.Timestamptz
  reminder2hSentAt  DateTime? @map("reminder_2h_sent_at") @db.Timestamptz
  outcomePromptedAt DateTime? @map("outcome_prompted_at") @db.Timestamptz
  createdBy   String    @map("created_by") // agent | user:<id>
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  calendar Calendar @relation(fields: [calendarId], references: [id])
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead     Lead?    @relation(fields: [leadId], references: [id])

  @@index([calendarId, startsAt])
  @@index([tenantId, unitId, startsAt])
  @@index([status, startsAt])
  @@index([status, endsAt])
  @@map("appointments")
}

model FollowUpPolicy {
  id                 String   @id @default(uuid()) @db.Uuid
  unitId             String   @unique @map("unit_id") @db.Uuid
  maxPerWeek         Int      @default(3) @map("max_per_week")
  minHoursBetween    Int      @default(20) @map("min_hours_between")
  maxAttempts        Int      @default(4) @map("max_attempts")
  quietHoursStart    String   @default("21:00") @map("quiet_hours_start")
  quietHoursEnd      String   @default("08:00") @map("quiet_hours_end")
  strategies         Json     @default("{}") // scenario → {delayHours, goal, style}
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("follow_up_policies")
}

model FollowUp {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  leadId         String    @map("lead_id") @db.Uuid
  conversationId String?   @map("conversation_id") @db.Uuid
  scheduledAt    DateTime  @map("scheduled_at") @db.Timestamptz
  reason         String
  goal           String?
  scenario       String? // price_then_silence | abandoned_scheduling | asked_later | qualified_waiting_payment | generic
  strategy       String? // text | template | task_for_human
  channel        String    @default("whatsapp")
  templateId     String?   @map("template_id") @db.Uuid
  draftMessage   String?   @map("draft_message")
  status         String    @default("scheduled") // scheduled | sent | cancelled | skipped | failed
  skipReason     String?   @map("skip_reason")
  attempt        Int       @default(1)
  createdBy      String    @default("agent") @map("created_by")
  sentAt         DateTime? @map("sent_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, scheduledAt])
  @@index([leadId])
  @@map("follow_ups")
}

// ───────────────────────────── Campaigns & templates ─────────────────────────────

model MessageTemplate {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  unitId       String?   @map("unit_id") @db.Uuid
  channelKind  String    @default("whatsapp") @map("channel_kind")
  name         String
  language     String    @default("pt_BR")
  category     String // MARKETING | UTILITY | AUTHENTICATION
  status       String    @default("draft") // draft | pending | approved | rejected | paused | disabled
  components   Json      @default("[]")
  variables    String[]
  body         String?
  qualityScore String?   @map("quality_score")
  providerId   String?   @map("provider_id")
  lastSyncAt   DateTime? @map("last_sync_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([tenantId, name, language])
  @@map("message_templates")
}

model Campaign {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  unitId      String    @map("unit_id") @db.Uuid
  name        String
  templateId  String?   @map("template_id") @db.Uuid
  segment     Json      @default("{}")
  variables   Json      @default("{}")
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz
  status      String    @default("draft") // draft | scheduled | running | paused | completed | cancelled
  rateLimitPerMin Int   @default(60) @map("rate_limit_per_min")
  stats       Json      @default("{}")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit       Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  template   MessageTemplate?    @relation(fields: [templateId], references: [id])
  recipients CampaignRecipient[]

  @@index([tenantId, unitId, status])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String    @id @default(uuid()) @db.Uuid
  campaignId String    @map("campaign_id") @db.Uuid
  contactId  String    @map("contact_id") @db.Uuid
  leadId     String?   @map("lead_id") @db.Uuid
  status     String    @default("pending") // pending | sent | delivered | read | replied | converted | unsubscribed | failed | skipped
  messageId  String?   @map("message_id") @db.Uuid
  error      String?
  sentAt     DateTime? @map("sent_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@map("campaign_recipients")
}

// ───────────────────────────── Integrations, automation, events ─────────────────────────────

model Integration {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  unitId         String?   @map("unit_id") @db.Uuid
  kind           String // whatsapp_meta | google_calendar | langfuse | smtp | s3 | payment_mercadopago | crm_hubspot | ...
  name           String
  status         String    @default("disconnected") // connected | disconnected | error
  config         Json      @default("{}") // non-sensitive
  credentialsEnc String?   @map("credentials_enc") // AES-256-GCM encrypted JSON
  lastError      String?   @map("last_error")
  lastSyncAt     DateTime? @map("last_sync_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit   Unit?  @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind])
  @@map("integrations")
}

model Webhook {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  url       String
  secret    String
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String    @id @default(uuid()) @db.Uuid
  webhookId    String    @map("webhook_id") @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  status       String    @default("pending") // pending | success | failed
  attempts     Int       @default(0)
  responseCode Int?      @map("response_code")
  lastError    String?   @map("last_error")
  deliveredAt  DateTime? @map("delivered_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, status])
  @@map("webhook_deliveries")
}

model Automation {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  unitId     String?  @map("unit_id") @db.Uuid
  name       String
  trigger    String // lead.created | message.received | ... (DomainEvent.type)
  conditions Json     @default("[]") // [{field, op, value}]
  actions    Json     @default("[]") // [{type, params}]
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit   Unit?           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  runs   AutomationRun[]

  @@index([tenantId, trigger, active])
  @@map("automations")
}

model AutomationRun {
  id           String   @id @default(uuid()) @db.Uuid
  automationId String   @map("automation_id") @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  status       String // success | failed | skipped
  result       Json?
  error        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, createdAt])
  @@map("automation_runs")
}

/// Transactional outbox + immutable event log (basis for analytics)
model DomainEvent {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  unitId        String?   @map("unit_id") @db.Uuid
  type          String // lead.created | message.received | stage.changed | ...
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  actor         String? // agent | user:<id> | system | automation:<id>
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  publishedAt   DateTime? @map("published_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([publishedAt])
  @@index([tenantId, type, occurredAt])
  @@index([aggregateType, aggregateId])
  @@map("domain_events")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  actor      String // user:<id> | agent | system | apikey:<id>
  action     String // e.g. prompt.publish, contact.export, lead.delete
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model IdempotencyKey {
  key       String   @id
  scope     String
  result    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt])
  @@map("idempotency_keys")
}

// ───────────────────────────── Payments & conversions ─────────────────────────────

model Payment {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  dealId      String?   @map("deal_id") @db.Uuid
  contactId   String    @map("contact_id") @db.Uuid
  provider    String // mock | mercadopago | asaas | pagarme | stripe
  externalId  String?   @map("external_id")
  amount      Decimal   @db.Decimal(12, 2)
  currency    String    @default("BRL")
  method      String? // pix | boleto | card
  status      String    @default("pending") // pending | paid | failed | refunded | cancelled
  paymentUrl  String?   @map("payment_url")
  paidAt      DateTime? @map("paid_at") @db.Timestamptz
  raw         Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal    Deal?   @relation(fields: [dealId], references: [id])
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("payments")
}

model ConversionEvent {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  contactId  String?   @map("contact_id") @db.Uuid
  leadId     String?   @map("lead_id") @db.Uuid
  eventName  String    @map("event_name") // Lead | QualifiedLead | Schedule | Visit | Purchase
  provider   String    @default("noop") // meta_capi | noop
  status     String    @default("pending") // pending | sent | failed
  value      Decimal?  @db.Decimal(12, 2)
  payload    Json      @default("{}")
  sentAt     DateTime? @map("sent_at") @db.Timestamptz
  error      String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, eventName, createdAt])
  @@map("conversion_events")
}
