// VOX2you Conversational CRM — database schema
// Conventions: snake_case tables/columns via @map, UUID ids, UTC timestamps,
// tenant_id on every business entity, unit_id where the entity belongs to a unit.
// Vector/tsvector columns are declared as Unsupported and managed via SQL migrations.

generator client {
  previewFeatures = ["postgresqlExtensions"]
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider   = "postgresql"
  extensions = [vector, pg_trgm, unaccent]
}

// ───────────────────────────── Organization ─────────────────────────────

model Tenant {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  slug          String   @unique
  status        String   @default("active") // active | suspended
  retentionDays Int      @default(730) @map("retention_days")
  settings      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  units          Unit[]
  users          User[]
  teams          Team[]
  apiKeys        ApiKey[]
  contacts       Contact[]
  companies      Company[]
  conversations  Conversation[]
  messages       Message[]
  pipelines      Pipeline[]
  leads          Lead[]
  deals          Deal[]
  tags           Tag[]
  lostReasons    LostReason[]
  products       Product[]
  knowledgeDocs  KnowledgeDocument[]
  prompts        Prompt[]
  agentRuns      AgentRun[]
  followUps      FollowUp[]
  campaigns      Campaign[]
  templates      MessageTemplate[]
  consents       Consent[]
  integrations   Integration[]
  webhooks       Webhook[]
  automations    Automation[]
  auditLogs      AuditLog[]
  domainEvents   DomainEvent[]
  evaluations    Evaluation[]
  datasets       Dataset[]
  appointments   Appointment[]
  tasks          Task[]
  payments       Payment[]
  conversionEvts ConversionEvent[]

  @@map("tenants")
}

model Unit {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  slug      String
  timezone  String   @default("America/Cuiaba")
  city      String?
  state     String?
  address   String?
  phone     String?
  email     String?
  status    String   @default("active")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userUnits      UserUnit[]
  channels       Channel[]
  conversations  Conversation[]
  pipelines      Pipeline[]
  leads          Lead[]
  products       Product[]
  classSchedules ClassSchedule[]
  knowledgeDocs  KnowledgeDocument[]
  agentSettings  AgentSettings?
  salesBrains    SalesBrainVersion[]
  scoringConfigs ScoringConfig[]
  calendars      Calendar[]
  followUpPolicy FollowUpPolicy?
  campaigns      Campaign[]
  integrations   Integration[]
  automations    Automation[]
  appointments   Appointment[]
  deals          Deal[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("units")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String
  name         String
  passwordHash String?   @map("password_hash")
  role         String    @default("seller") // owner | admin | manager | seller | viewer
  status       String    @default("active") // active | invited | disabled
  avatarUrl    String?   @map("avatar_url")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  settings     Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units            UserUnit[]
  teamMembers      TeamMember[]
  refreshTokens    RefreshToken[]
  assignedConvs    Conversation[]  @relation("ConversationAssignee")
  ownedLeads       Lead[]          @relation("LeadOwner")
  recommendedLeads Lead[]          @relation("LeadRecommendedOwner")
  tasks            Task[]          @relation("TaskAssignee")
  notes            Note[]
  promptVersions   PromptVersion[]
  evaluations      Evaluation[]
  feedbacks        Feedback[]
  auditLogs        AuditLog[]
  messages         Message[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model UserUnit {
  userId String @map("user_id") @db.Uuid
  unitId String @map("unit_id") @db.Uuid
  role   String @default("seller")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId])
  @@map("user_units")
}

model Team {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members TeamMember[]

  @@index([tenantId])
  @@map("teams")
}

model TeamMember {
  teamId String @map("team_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  family    String    @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  keyHash    String    @unique @map("key_hash")
  prefix     String
  scopes     String[]
  unitIds    String[]  @map("unit_ids") @db.Uuid
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

// ───────────────────────────── Channels ─────────────────────────────

/// A messaging channel connected to a unit (e.g. a WhatsApp phone number)
model Channel {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  unitId     String   @map("unit_id") @db.Uuid
  kind       String // whatsapp | instagram | messenger | webchat | email | sms
  provider   String // meta | mock | twilio | ...
  externalId String   @map("external_id") // phone_number_id for Meta
  name       String
  status     String   @default("active")
  config     Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  unit          Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  /// Global (not per-tenant): a provider account (Meta phone_number_id) belongs to exactly one unit.
  /// Inbound routing derives the tenant from this id, so cross-tenant duplicates would allow one
  /// tenant to capture another tenant's messages.
  @@unique([kind, externalId])
  @@index([tenantId, unitId])
  @@map("channels")
}

// ───────────────────────────── Contacts ─────────────────────────────

model Contact {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  companyId     String?   @map("company_id") @db.Uuid
  name          String?
  firstName     String?   @map("first_name")
  phone         String? // E.164
  email         String?
  jobTitle      String?   @map("job_title")
  city          String?
  state         String?
  profileType   String?   @map("profile_type") // b2c | b2b
  source        String? // whatsapp_organic | click_to_whatsapp | instagram | referral | qr | landing | import
  language      String    @default("pt-BR")
  timezone      String?
  isAnonymized  Boolean   @default(false) @map("is_anonymized")
  lastSeenAt    DateTime? @map("last_seen_at") @db.Timestamptz
  attributes    Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company       Company?          @relation(fields: [companyId], references: [id])
  identities    ContactIdentity[]
  conversations Conversation[]
  leads         Lead[]
  consents      Consent[]
  attribution   Attribution[]
  appointments  Appointment[]
  payments      Payment[]
  tags          ContactTag[]
  notes         Note[]

  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, updatedAt])
  @@map("contacts")
}

model ContactIdentity {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  contactId  String   @map("contact_id") @db.Uuid
  channel    String // whatsapp | instagram | messenger | email | webchat
  externalId String   @map("external_id") // wa_id (E.164 digits), IG scoped id, email…
  displayName String? @map("display_name")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel, externalId])
  @@index([contactId])
  @@map("contact_identities")
}

model Company {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String
  document   String? // CNPJ
  segment    String?
  size       String? // micro | small | medium | large
  website    String?
  city       String?
  attributes Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts Contact[]

  @@index([tenantId, name])
  @@map("companies")
}

model Consent {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  contactId  String    @map("contact_id") @db.Uuid
  purpose    String // marketing | service | ai_processing
  status     String // opted_in | opted_out | unknown
  source     String? // inbound_message | form | import | agent | user
  evidence   String?
  grantedAt  DateTime? @map("granted_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, purpose])
  @@index([tenantId])
  @@map("consents")
}

model Attribution {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  contactId    String   @map("contact_id") @db.Uuid
  leadId       String?  @map("lead_id") @db.Uuid
  utmSource    String?  @map("utm_source")
  utmMedium    String?  @map("utm_medium")
  utmCampaign  String?  @map("utm_campaign")
  utmContent   String?  @map("utm_content")
  utmTerm      String?  @map("utm_term")
  fbclid       String?
  ctwaClid     String?  @map("ctwa_clid")
  referralType String?  @map("referral_type") // click_to_whatsapp | qr | landing | referral | campaign
  sourceUrl    String?  @map("source_url")
  headline     String?
  adId         String?  @map("ad_id")
  raw          Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead    Lead?   @relation(fields: [leadId], references: [id])

  @@index([tenantId, utmCampaign])
  @@index([contactId])
  @@map("attributions")
}

// ───────────────────────────── Conversations ─────────────────────────────

model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  unitId        String    @map("unit_id") @db.Uuid
  channelId     String    @map("channel_id") @db.Uuid
  contactId     String    @map("contact_id") @db.Uuid
  leadId        String?   @map("lead_id") @db.Uuid
  status        String    @default("open") // open | closed
  mode          String    @default("ai") // ai | human | paused
  assigneeId    String?   @map("assignee_id") @db.Uuid
  summary       String?
  summaryUpToMessageId String? @map("summary_up_to_message_id") @db.Uuid
  sentiment     String? // positive | neutral | negative | frustrated
  lastInboundAt DateTime? @map("last_inbound_at") @db.Timestamptz
  lastOutboundAt DateTime? @map("last_outbound_at") @db.Timestamptz
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz
  lastMessagePreview String? @map("last_message_preview")
  unreadCount   Int       @default(0) @map("unread_count")
  handoffReason String?   @map("handoff_reason")
  handoffAt     DateTime? @map("handoff_at") @db.Timestamptz
  handoffSummary Json?    @map("handoff_summary")
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  closedAt      DateTime? @map("closed_at") @db.Timestamptz

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit      Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  channel   Channel    @relation(fields: [channelId], references: [id])
  contact   Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead      Lead?      @relation(fields: [leadId], references: [id])
  assignee  User?      @relation("ConversationAssignee", fields: [assigneeId], references: [id])
  messages  Message[]
  agentRuns AgentRun[]
  followUps FollowUp[]
  evaluations Evaluation[]

  @@index([tenantId, unitId, status, lastMessageAt])
  @@index([contactId])
  @@index([assigneeId])
  @@map("conversations")
}

model Message {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  conversationId    String    @map("conversation_id") @db.Uuid
  direction         String // inbound | outbound
  type              String // text | audio | image | video | document | location | interactive | template | contacts | reaction | system | sticker | unknown
  authorType        String    @map("author_type") // contact | agent | user | system
  authorUserId      String?   @map("author_user_id") @db.Uuid
  text              String?
  transcript        String?
  transcriptLanguage String?  @map("transcript_language")
  status            String    @default("received") // received | queued | sent | delivered | read | failed | blocked
  providerMessageId String?   @map("provider_message_id")
  replyToMessageId  String?   @map("reply_to_message_id") @db.Uuid
  templateName      String?   @map("template_name")
  errorCode         String?   @map("error_code")
  errorTitle        String?   @map("error_title")
  agentRunId        String?   @map("agent_run_id") @db.Uuid
  payload           Json      @default("{}")
  sentAt            DateTime? @map("sent_at") @db.Timestamptz
  deliveredAt       DateTime? @map("delivered_at") @db.Timestamptz
  readAt            DateTime? @map("read_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorUser   User?         @relation(fields: [authorUserId], references: [id])
  attachments  Attachment[]
  agentRun     AgentRun?     @relation("MessageAgentRun", fields: [agentRunId], references: [id])
  feedbacks    Feedback[]

  @@unique([tenantId, providerMessageId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model Attachment {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  messageId  String   @map("message_id") @db.Uuid
  kind       String // audio | image | video | document | sticker
  storageKey String?  @map("storage_key")
  providerMediaId String? @map("provider_media_id")
  mimeType   String?  @map("mime_type")
  sizeBytes  Int?     @map("size_bytes")
  fileName   String?  @map("file_name")
  caption    String?
  durationSec Float?  @map("duration_sec")
  sha256     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("attachments")
}

// ───────────────────────────── CRM ─────────────────────────────

model Pipeline {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  unitId    String?  @map("unit_id") @db.Uuid
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit   Unit?           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  stages PipelineStage[]
  leads  Lead[]

  @@index([tenantId, unitId])
  @@map("pipelines")
}

model PipelineStage {
  id              String   @id @default(uuid()) @db.Uuid
  pipelineId      String   @map("pipeline_id") @db.Uuid
  key             String // new | conversing | discovery | qualified | offer | scheduling | negotiation | won | lost | nurture | custom
  name            String
  order           Int
  kind            String   @default("open") // open | won | lost | nurture
  probability     Int      @default(10)
  maxHoursInStage Int?     @map("max_hours_in_stage")
  color           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@unique([pipelineId, key])
  @@index([pipelineId, order])
  @@map("pipeline_stages")
}

model Lead {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  unitId               String    @map("unit_id") @db.Uuid
  contactId            String    @map("contact_id") @db.Uuid
  pipelineId           String    @map("pipeline_id") @db.Uuid
  stageId              String    @map("stage_id") @db.Uuid
  ownerId              String?   @map("owner_id") @db.Uuid
  status               String    @default("open") // open | won | lost | nurture
  title                String?
  profileType          String?   @map("profile_type") // b2c | b2b
  interestProductId    String?   @map("interest_product_id") @db.Uuid
  recommendedProductId String?   @map("recommended_product_id") @db.Uuid
  recommendedOwnerId   String?   @map("recommended_owner_id") @db.Uuid
  score                Int       @default(0)
  scoreBreakdown       Json      @default("[]") @map("score_breakdown")
  probability          Int       @default(10)
  estimatedValue       Decimal?  @map("estimated_value") @db.Decimal(12, 2)
  currency             String    @default("BRL")
  urgency              String? // low | medium | high
  mainPain             String?   @map("main_pain")
  goal                 String?
  nextBestAction       String?   @map("next_best_action")
  nextBestMessage      String?   @map("next_best_message")
  nextFollowupAt       DateTime? @map("next_followup_at") @db.Timestamptz
  nextFollowupReason   String?   @map("next_followup_reason")
  doNotContactUntil    DateTime? @map("do_not_contact_until") @db.Timestamptz
  lostReasonId         String?   @map("lost_reason_id") @db.Uuid
  lostReasonDetail     String?   @map("lost_reason_detail")
  lostReasonSuggestedByAi Boolean @default(false) @map("lost_reason_suggested_by_ai")
  lostReasonConfirmed  Boolean   @default(false) @map("lost_reason_confirmed")
  stageEnteredAt       DateTime  @default(now()) @map("stage_entered_at") @db.Timestamptz
  qualifiedAt          DateTime? @map("qualified_at") @db.Timestamptz
  wonAt                DateTime? @map("won_at") @db.Timestamptz
  lostAt               DateTime? @map("lost_at") @db.Timestamptz
  lastInteractionAt    DateTime? @map("last_interaction_at") @db.Timestamptz
  aiSummary            String?   @map("ai_summary")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit               Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  contact            Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  pipeline           Pipeline            @relation(fields: [pipelineId], references: [id])
  stage              PipelineStage       @relation(fields: [stageId], references: [id])
  owner              User?               @relation("LeadOwner", fields: [ownerId], references: [id])
  recommendedOwner   User?               @relation("LeadRecommendedOwner", fields: [recommendedOwnerId], references: [id])
  interestProduct    Product?            @relation("LeadInterestProduct", fields: [interestProductId], references: [id])
  recommendedProduct Product?            @relation("LeadRecommendedProduct", fields: [recommendedProductId], references: [id])
  lostReason         LostReason?         @relation(fields: [lostReasonId], references: [id])
  conversations      Conversation[]
  facts              LeadFact[]
  scoreSnapshots     LeadScoreSnapshot[]
  stageHistory       LeadStageHistory[]
  tasks              Task[]
  tags               LeadTag[]
  deals              Deal[]
  followUps          FollowUp[]
  appointments       Appointment[]
  attributions       Attribution[]
  notes              Note[]
  agentRuns          AgentRun[]
  evaluations        Evaluation[]

  @@index([tenantId, unitId, status, stageId])
  @@index([contactId])
  @@index([ownerId])
  @@index([nextFollowupAt])
  @@map("leads")
}

model LeadStageHistory {
  id          String   @id @default(uuid()) @db.Uuid
  leadId      String   @map("lead_id") @db.Uuid
  fromStageId String?  @map("from_stage_id") @db.Uuid
  toStageId   String   @map("to_stage_id") @db.Uuid
  changedBy   String   @map("changed_by") // agent | user:<id> | automation:<id> | system
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_stage_history")
}

/// Structured, persistent memory about a lead. Never ask again what is already here.
model LeadFact {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  leadId            String    @map("lead_id") @db.Uuid
  key               String // goal | pain | objection | interest_product | preferred_period | decision_timeline | decision_maker | budget_signal | company_size | role | availability | ...
  value             String
