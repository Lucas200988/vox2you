# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
# Used by the web app (server + browser) to reach the API
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Database / cache ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://vox:vox@localhost:5432/vox
REDIS_URL=redis://localhost:6379

# ─── Security (generate with: openssl rand -base64 48) ───────────────────────
JWT_SECRET=change-me-min-32-bytes
APP_ENCRYPTION_KEY=change-me-32-bytes-base64
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ─── LLM providers ───────────────────────────────────────────────────────────
# Set LLM_PROVIDER=mock to run without credentials (dev/tests/playground)
LLM_PROVIDER=mock                # anthropic | openai | mock
ANTHROPIC_API_KEY=               # PENDING credential
OPENAI_API_KEY=                  # PENDING credential (embeddings + whisper)
LLM_MODEL_FAST=claude-haiku-4-5
LLM_MODEL_SMART=claude-opus-5
LLM_MODEL_EVAL=claude-opus-5

# ─── Embeddings ──────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=hash          # openai | hash
EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_EMBEDDING_DIM=1536

# ─── Speech to text ──────────────────────────────────────────────────────────
STT_PROVIDER=mock                # openai | mock

# ─── WhatsApp (Meta Cloud API) ───────────────────────────────────────────────
MESSAGING_PROVIDER=mock          # meta | mock
WHATSAPP_ACCESS_TOKEN=           # PENDING credential
WHATSAPP_PHONE_NUMBER_ID=        # PENDING credential
WHATSAPP_BUSINESS_ACCOUNT_ID=    # PENDING credential
WHATSAPP_APP_SECRET=             # PENDING credential (webhook HMAC)
WHATSAPP_VERIFY_TOKEN=choose-a-random-verify-token
WHATSAPP_GRAPH_VERSION=v21.0

# ─── Calendar ────────────────────────────────────────────────────────────────
CALENDAR_PROVIDER=internal       # google | internal
GOOGLE_SERVICE_ACCOUNT_JSON=     # PENDING credential (base64 of service account json)
GOOGLE_CALENDAR_ID=

# ─── Storage ─────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local           # s3 | local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vox-media
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=true

# ─── Observability ───────────────────────────────────────────────────────────
TRACE_SINK=console               # langfuse | console | db
LANGFUSE_PUBLIC_KEY=             # PENDING credential
LANGFUSE_SECRET_KEY=             # PENDING credential
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ─── Email ───────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VOX2you <no-reply@vox2you.com.br>"

# ─── Meta Conversions API (P1) ───────────────────────────────────────────────
META_PIXEL_ID=
META_CAPI_TOKEN=

# ─── Seed ────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@vox2you.local
SEED_ADMIN_PASSWORD=admin12345

# ─── Produção (docker-compose.prod.yml + ops/deploy.sh) ──────────────────────
# DNS: aponte DOMAIN_APP e DOMAIN_API para o host; o Caddy emite os certificados.
DOMAIN_APP=app.vox2you.com.br
DOMAIN_API=api.vox2you.com.br
ACME_EMAIL=ti@vox2you.com.br
POSTGRES_PASSWORD=change-me
METRICS_TOKEN=                   # opcional: bearer exigido em GET /metrics
BACKUP_HOUR=03                   # hora UTC do backup diário
BACKUP_KEEP_DAYS=14
BACKUP_RCLONE_REMOTE=            # ex.: s3backup:vox-backups/prod (ver ops/backup/rclone.conf)
GRAFANA_ADMIN_PASSWORD=change-me # só com --profile monitoring
# Worker: a réplica que roda os schedulers usa SCHEDULERS=1; réplicas extras usam 0
SCHEDULERS=1
